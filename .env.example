# Copy to .env (just setup does it and fills the secrets). Never commit .env.

ENV=dev
PUBLIC_BASE_URL=http://localhost:3100
CORS_ORIGINS=["http://localhost:3100"]

DATABASE_URL=postgresql+asyncpg://rescuegrid:rescuegrid@localhost:5432/rescuegrid
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=rescuegrid

# Understanding. "local" reads messages with the built-in multilingual rules and sends
# nothing off the machine. "gemini" or "ollama" adds a model on top; phone numbers are
# always removed first, but names, addresses and medical details are sent to the provider.
# Choosing a hosted provider for real SOS traffic is a data-protection decision.
LLM_PROVIDER=local
LLM_MODEL=
EMBED_MODEL=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
LLM_MAX_RPM=12
# Gemini free tier example:
#   LLM_PROVIDER=gemini  LLM_MODEL=gemini-3.5-flash-lite  EMBED_MODEL=gemini-embedding-001
# Local example (ollama pull qwen3:4b nomic-embed-text):
#   LLM_PROVIDER=ollama  LLM_MODEL=qwen3:4b  EMBED_MODEL=nomic-embed-text

# Geocoding fallbacks after the OSM gazetteer (public Nominatim allows 1 request a second)
NOMINATIM_URL=
GOOGLE_MAPS_API_KEY=

# Routing: estimate (no service), valhalla (avoids flood polygons), or osrm
ROUTER=estimate
ROUTER_URL=
DISPATCH_TIME_LIMIT_S=3
DISPATCH_DEBOUNCE_S=5

# Meta WhatsApp Cloud API. Outbound replies are logged as skipped until all four are set.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Web push to field leads (just setup generates a key pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@rescuegrid.in

# Secrets: just setup generates real values
JWT_SECRET=
JWT_EXPIRES_MIN=30
DATA_ENCRYPTION_KEYS=
DATA_HASH_KEY=
COOKIE_SECURE=false

# Demo and ops
DEMO_MODE=true
OTP_DEV_ECHO=true
WORKERS_INLINE=true
# flood ensemble members the workers simulate at once; keep a core or two free for the API and Redis
NOWCAST_THREADS=4
RETENTION_DAYS=90
SENTRY_DSN=

# Web
NEXT_PUBLIC_WS_URL=ws://localhost:8000
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MAP_STYLE_DARK=
NEXT_PUBLIC_MAP_STYLE_LIGHT=

# Deploy (just stack). A domain here gets HTTPS from Caddy automatically; then set
# PUBLIC_BASE_URL and CORS_ORIGINS to https://that-domain, COOKIE_SECURE=true and ENV=prod.
SITE_ADDRESS=:80
# shown on the privacy and terms pages so people can ask for their data to be deleted
CONTACT_EMAIL=
